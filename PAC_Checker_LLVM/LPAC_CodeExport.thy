definition slice_to_str :: \<open>char list \<Rightarrow> char list\<close>
  where \<open>slice_to_str \<equiv> ARR2LS\<close>

lemmas stra_ARR2LS_hnr = ARR2LS_hnr[OF char_assn_pure]

