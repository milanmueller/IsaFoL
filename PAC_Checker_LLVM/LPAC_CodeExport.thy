theory LPAC_CodeExport
  imports
    LPAC_Efficient_Checker_Synthesis
    LLVM_ASCII_String
    IICF_Copying_List
begin

text \<open>This theory defines types for the c interface and also handles importing
  the data generated by the c parser into the target datatypes of the verified
  parser. Note that most functions in here are not verified, so they are part of the
  trusted code base.\<close>

section \<open>A ternary union type\<close>

text \<open>The library only ships the binary union example \<open>ll_sum\<close> (and not in the
  IICF import). The tagged union in \<open>rule\<close> has three members, so we provide a
  ternary union type, modelled on \<open>ll_sum\<close>.\<close>

declare [[llc_compile_union=true]]

datatype ('a,'b,'c) ll_union3 =
    is_U3Zero: U3Zero
  | is_U3a: U3a (the_u3a: 'a)
  | is_U3b: U3b (the_u3b: 'b)
  | is_U3c: U3c (the_u3c: 'c)

instantiation ll_union3 :: (llvm_rep,llvm_rep,llvm_rep) llvm_rep
begin
  fun to_val_ll_union3 :: \<open>('a,'b,'c) ll_union3 \<Rightarrow> llvm_val\<close> where
    "to_val_ll_union3 U3Zero = LL_UNION (UN_ZERO_INIT [struct_of TYPE('a), struct_of TYPE('b), struct_of TYPE('c)])"
  | "to_val_ll_union3 (U3a x) = LL_UNION (UN_SEL [] (to_val x) [struct_of TYPE('b), struct_of TYPE('c)])"
  | "to_val_ll_union3 (U3b x) = LL_UNION (UN_SEL [struct_of TYPE('a)] (to_val x) [struct_of TYPE('c)])"
  | "to_val_ll_union3 (U3c x) = LL_UNION (UN_SEL [struct_of TYPE('a), struct_of TYPE('b)] (to_val x) [])"

  fun from_val_ll_union3 :: \<open>llvm_val \<Rightarrow> ('a,'b,'c) ll_union3\<close> where
    "from_val_ll_union3 (LL_UNION (UN_ZERO_INIT _)) = U3Zero"
  | "from_val_ll_union3 (LL_UNION (UN_SEL [] x [_,_])) = U3a (from_val x)"
  | "from_val_ll_union3 (LL_UNION (UN_SEL [_] x [_])) = U3b (from_val x)"
  | "from_val_ll_union3 (LL_UNION (UN_SEL [_,_] x [])) = U3c (from_val x)"
  | "from_val_ll_union3 _ = undefined"

  definition [simp]: "struct_of_ll_union3 (_::('a,'b,'c) ll_union3 itself) = VS_UNION [struct_of TYPE('a), struct_of TYPE('b), struct_of TYPE('c)]"
  definition [simp]: "init_ll_union3 = U3Zero"

  instance
    apply standard
    apply (all \<open>(clarsimp simp: comp_def fun_eq_iff)?\<close>)
    subgoal for x by (cases x) auto
    subgoal for v by (cases v rule: from_val_ll_union3.cases) auto
    subgoal for x by (cases x) auto
    done
end

lemma struct_of_ll_union3[ll_struct_of]:
  "struct_of TYPE(('a::llvm_rep,'b::llvm_rep,'c::llvm_rep) ll_union3) = VS_UNION [struct_of TYPE('a), struct_of TYPE('b), struct_of TYPE('c)]"
  by simp

definition ll_u3_extr_a :: \<open>('a::llvm_rep,'b::llvm_rep,'c::llvm_rep) ll_union3 \<Rightarrow> 'a llM\<close> where
  [llvm_code,llvm_inline]: \<open>ll_u3_extr_a x \<equiv> ll_dest_union x 0\<close>

definition ll_u3_extr_b :: \<open>('a::llvm_rep,'b::llvm_rep,'c::llvm_rep) ll_union3 \<Rightarrow> 'b llM\<close> where
  [llvm_code,llvm_inline]: \<open>ll_u3_extr_b x \<equiv> ll_dest_union x 1\<close>

definition ll_u3_extr_c :: \<open>('a::llvm_rep,'b::llvm_rep,'c::llvm_rep) ll_union3 \<Rightarrow> 'c llM\<close> where
  [llvm_code,llvm_inline]: \<open>ll_u3_extr_c x \<equiv> ll_dest_union x 2\<close>

lemma ll_u3_extr_simps:
  \<open>is_U3a x \<Longrightarrow> ll_u3_extr_a x = Mreturn (the_u3a x)\<close>
  \<open>is_U3b x \<Longrightarrow> ll_u3_extr_b x = Mreturn (the_u3b x)\<close>
  \<open>is_U3c x \<Longrightarrow> ll_u3_extr_c x = Mreturn (the_u3c x)\<close>
  unfolding ll_u3_extr_a_def ll_u3_extr_b_def ll_u3_extr_c_def
  by (cases x; simp add: ll_dest_union_def checked_from_val_def llvm_dest_union_def)+

lemma ll_u3_extr_rules[vcg_rules]:
  \<open>llvm_htriple (\<up>(is_U3a x)) (ll_u3_extr_a x) (\<lambda>r. \<up>(r = the_u3a x))\<close>
  \<open>llvm_htriple (\<up>(is_U3b x)) (ll_u3_extr_b x) (\<lambda>r. \<up>(r = the_u3b x))\<close>
  \<open>llvm_htriple (\<up>(is_U3c x)) (ll_u3_extr_c x) (\<lambda>r. \<up>(r = the_u3c x))\<close>
  supply [vcg_normalize_simps] = ll_u3_extr_simps
  by vcg

section \<open>C Interface Types\<close>

text \<open>We describe the datatypes that will be instantiated by the c parser.\<close>

type_synonym c_slice = \<open>64 word \<times> 8 word ptr\<close>
type_synonym c_term = \<open>64 word \<times> c_slice ptr\<close>
type_synonym c_monomial = \<open>c_slice \<times> 8 word \<times> c_term\<close>
type_synonym c_polynomial = \<open>64 word \<times> c_monomial ptr\<close>

type_synonym c_input = \<open>64 word \<times> c_polynomial\<close>
type_synonym c_inputs = \<open>64 word \<times> c_input ptr\<close>

type_synonym c_summand = \<open>c_polynomial ptr \<times> 64 word\<close>
type_synonym c_summands = \<open>64 word \<times> c_summand ptr\<close>
type_synonym c_lc_rule = \<open>64 word \<times> c_summands \<times> c_polynomial\<close>
type_synonym c_del_rule = \<open>64 word\<close>
type_synonym c_ext_rule = \<open>64 word \<times> c_slice \<times> c_polynomial\<close>
type_synonym c_rule = \<open>32 word \<times> (c_lc_rule, c_del_rule, c_ext_rule) ll_union3\<close>
type_synonym c_proof = \<open>64 word \<times> c_rule ptr\<close>

type_synonym c_target = \<open>c_polynomial\<close>

section \<open>Import functions\<close>

subsection \<open>Generic Array to Open List Conversion\<close>

text \<open>We define a synonym for `id` to indicate Array to list conversion on the HOL level.
  Similarly to how we can use `COPY` on the HOL side to enforce copying of structures.\<close>
definition \<open>ARR2LS = (id :: 'a list \<Rightarrow> 'a list)\<close>

lemma arr2ls_refine: \<open>(\<lambda>x. RETURN x, RETURN o ARR2LS) \<in> Id \<rightarrow>\<^sub>f \<langle>Id\<rangle>nres_rel\<close>
  apply (intro frefI nres_relI)
  unfolding ARR2LS_def
  by auto

definition arr_to_list :: \<open>'a list \<Rightarrow> 'a list nres\<close> where
  \<open>arr_to_list arr = doN{
    ASSERT(length arr < max_snat 64);
    let l = length arr;
    (ls, _) \<leftarrow> WHILEIT
      (\<lambda>(ls, i). i \<le> length arr \<and> ls = drop (l-i) arr)
      (\<lambda>(_, i). i < length arr)
      (\<lambda>(ls, i). doN {
        ASSERT(i < length arr);
        RETURN(arr!(l-i-1) # ls, i+1)
      })
      ([], 0);
    RETURN ls
  }\<close>

lemma arr_to_list_correct:
    shows \<open>(arr_to_list, \<lambda>x. RETURN x) \<in> [\<lambda> arr. length arr < max_snat 64]\<^sub>f Id \<rightarrow> \<langle>Id\<rangle>nres_rel\<close>
  apply (intro frefI nres_relI)
  subgoal for x y
    unfolding arr_to_list_def
    apply (refine_vcg WHILEIT_rule[where R="measure (\<lambda>(_, i). length x - i)"])
    apply clarsimp_all
    subgoal by (metis drop_minus rev_nth)
    subgoal by linarith
    done
  done

lemmas arr_to_list_refine = arr_to_list_correct[FCOMP arr2ls_refine]

context
  fixes A :: \<open>'a \<Rightarrow> 'b::llvm_rep \<Rightarrow> assn\<close>
  assumes PURE: \<open>is_pure A\<close>
  notes [safe_constraint_rules] = PURE
  notes [sepref_frame_free_rules] = mk_free_is_pure[OF PURE]
begin

sepref_definition parr_to_list_impl is \<open>arr_to_list\<close>
  :: \<open>(larray_assn' size_t A)\<^sup>k \<rightarrow>\<^sub>a (cl_assn' A)\<close>
  unfolding arr_to_list_def
  apply (annot_snat_const size_t)
  by sepref

lemmas ARR2LS_hnr =
  parr_to_list_impl.refine[FCOMP arr_to_list_refine]

end

subsection \<open>Generic Array to List Conversion with Owned Elements\<close>

definition is_import
  :: \<open>('a \<Rightarrow> 'b::llvm_rep \<Rightarrow> assn) \<Rightarrow> ('a \<Rightarrow> 'c::llvm_rep \<Rightarrow> assn) \<Rightarrow> ('b \<Rightarrow> 'c llM) \<Rightarrow> bool\<close>
  where \<open>is_import A B impf \<equiv> (impf, RETURN o COPY) \<in> A\<^sup>k \<rightarrow>\<^sub>a B\<close>

lemma is_copy_is_import: \<open>is_copy A cp \<Longrightarrow> is_import A A cp\<close>
  unfolding is_copy_def is_import_def .

lemma is_pure_is_import: \<open>is_pure A \<Longrightarrow> is_import A A Mreturn\<close>
  using is_copy_pure_gen_algo[unfolded CONSTRAINT_def GEN_ALGO_def]
  by (blast intro: is_copy_is_import)

definition wo_nth_import :: \<open>('b::llvm_rep \<Rightarrow> 'c::llvm_rep llM) \<Rightarrow> 'b ptr \<Rightarrow> 64 word \<Rightarrow> 'c llM\<close>
  where [llvm_inline]: \<open>wo_nth_import impf p i \<equiv> doM {
    x \<leftarrow> array_nth p i;
    r \<leftarrow> impf x;
    p \<leftarrow> array_upd p i x;
    Mreturn r
  }\<close>

definition ARR2LS_n :: \<open>nat \<Rightarrow> 'a list \<Rightarrow> 'a list\<close> where
  \<open>ARR2LS_n n xs = xs\<close>

definition arr_to_list_n :: \<open>nat \<Rightarrow> 'a list \<Rightarrow> 'a list nres\<close> where
  \<open>arr_to_list_n n arr = doN {
    ASSERT (n = length arr \<and> n < max_snat 64);
    (ls, _) \<leftarrow> WHILEIT
      (\<lambda>(ls, i). i \<le> n \<and> ls = drop (n - i) arr)
      (\<lambda>(_, i). i < n)
      (\<lambda>(ls, i). doN {
        ASSERT (i < n \<and> n < max_snat 64);
        x \<leftarrow> mop_list_get arr (n - i - 1);
        RETURN (x # ls, i + 1)
      })
      ([], 0);
    RETURN ls
  }\<close>

lemma arr_to_list_n_le:
  fixes n :: nat and arr :: \<open>'a list\<close>
  assumes \<open>n = length arr\<close> and \<open>n < max_snat 64\<close>
  shows \<open>arr_to_list_n n arr \<le> RETURN arr\<close>
  unfolding arr_to_list_n_def mop_list_get_alt
  apply (refine_vcg WHILEIT_rule[where R=\<open>measure (\<lambda>(_, i). n - i)\<close>])
  using assms
  apply clarsimp_all
  subgoal by (simp add: drop_minus rev_nth)
  subgoal by linarith
  done

lemma arr_to_list_n_correct:
  \<open>(uncurry arr_to_list_n, uncurry (RETURN oo ARR2LS_n))
    \<in> [\<lambda>(n, arr). n = length arr \<and> n < max_snat 64]\<^sub>f Id \<times>\<^sub>r Id \<rightarrow> \<langle>Id\<rangle>nres_rel\<close>
  by (intro frefI nres_relI)
     (auto simp: ARR2LS_n_def intro!: arr_to_list_n_le)

context
  fixes A :: \<open>'a \<Rightarrow> 'b::llvm_rep \<Rightarrow> assn\<close>
    and B :: \<open>'a \<Rightarrow> 'c::llvm_rep \<Rightarrow> assn\<close>
    and impf :: \<open>'b \<Rightarrow> 'c llM\<close>
  assumes IMP: \<open>is_import A B impf\<close>
  notes [safe_constraint_rules] = CN_FALSEI[of is_pure A]
begin

text \<open>NB: \<open>import_rule\<close> and \<open>wo_nth_import_rule\<close> must NOT carry a global
  \<open>[vcg_rules]\<close> attribute: on context exit the attribute is re-applied to the
  exported rule, which is guarded by the (never dischargeable) premise
  \<open>is_import ?A ?B ?impf\<close> and — for \<open>import_rule\<close> — has the fully schematic
  command head \<open>?impf ?c\<close> that HO-unifies with every command. Such a rule makes
  every later \<open>vcg\<close> invocation in the import closure diverge. Supply the rules
  locally in the proofs (inside this context) that need them.\<close>

lemma import_rule: \<open>llvm_htriple (A a c) (impf c) (\<lambda>r. A a c ** B a r)\<close>
  using hfref_htriple_k1[OF IMP[unfolded is_import_def]] by simp

lemma wo_nth_import_rule:
  \<open>llvm_htriple
     (eoarray_assn A (map Some xs) p ** \<upharpoonleft>snat.assn i ii ** \<up>\<^sub>d(i < length xs))
     (wo_nth_import impf p ii)
     (\<lambda>r. eoarray_assn A (map Some xs) p ** B (xs ! i) r)\<close>
  unfolding wo_nth_import_def eoarray_assn_def
  supply [simp] = map_update[symmetric]
  supply [vcg_rules] = import_rule
  by vcg

lemma wo_nth_import_hnr[sepref_fr_rules]:
  \<open>(uncurry (wo_nth_import impf), uncurry mop_list_get)
    \<in> (woarray_assn A)\<^sup>k *\<^sub>a (snat_assn' TYPE(64))\<^sup>k \<rightarrow>\<^sub>a B\<close>
  unfolding snat_rel_def snat.assn_is_rel[symmetric]
  apply sepref_to_hoare
  apply (clarsimp simp: refine_pw_simps mop_list_get_alt woarray_assn_conv)
  supply [vcg_rules] = wo_nth_import_rule
  apply vcg
  done

sepref_definition arr_to_list_import_impl is \<open>uncurry arr_to_list_n\<close>
  :: \<open>(snat_assn' TYPE(size_t))\<^sup>k *\<^sub>a (woarray_assn A)\<^sup>k \<rightarrow>\<^sub>a cl_assn' B\<close>
  unfolding arr_to_list_n_def
  apply (annot_snat_const size_t)
  by sepref

lemmas ARR2LS_n_hnr = arr_to_list_import_impl.refine[FCOMP arr_to_list_n_correct]

end

definition arr_with_len_assn
  :: \<open>('a \<Rightarrow> 'b::llvm_rep \<Rightarrow> assn) \<Rightarrow> 'a list \<Rightarrow> 64 word \<times> 'b ptr \<Rightarrow> assn\<close>
  where \<open>arr_with_len_assn A \<equiv> \<lambda>xs (ni, pi).
    \<upharpoonleft>snat.assn (length xs) ni ** woarray_assn A xs pi\<close>

lemma arr_to_list_import_is_import:
  assumes IMP: \<open>is_import A B impf\<close>
  shows \<open>is_import (arr_with_len_assn A) (cl_assn' B)
           (\<lambda>(ni, pi). arr_to_list_import_impl impf ni pi)\<close>
proof -
  note HT = hfref_htriple_k1_k2_guard[OF ARR2LS_n_hnr[OF IMP]]
  show ?thesis
    unfolding is_import_def
    apply sepref_to_hoare
    apply (clarsimp simp: arr_with_len_assn_def)
    subgoal for xs ni pi
      apply (rule htriple_pure_preI)
      apply (clarsimp dest!: pure_part_split_conj)
      subgoal premises prems
      proof -
        have PRE: \<open>(\<lambda>(n, arr). n = length arr \<and> n < max_snat 64) (length xs, xs)\<close>
          using prems snat_lt_max_snat[of ni] by (auto simp: snat.assn_def)
        show ?thesis
          using HT[OF PRE, of ni pi]
          by (simp add: ARR2LS_n_def pure_app_eq in_snat_rel_conv_assn
            snat.assn_is_rel[symmetric] snat_rel_def sep_algebra_simps)
      qed
      done
    done
qed

