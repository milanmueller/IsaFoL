subsubsection \<open>The constant 0 at \<open>sbi_assn\<close>\<close>

definition int0 :: int where \<open>int0 \<equiv> 0\<close>

definition signed_big_int0 :: signed_big_int where
  \<open>signed_big_int0 \<equiv> ([], False)\<close>

lemma signed_big_int0_\<alpha>: \<open>signed_big_int_to_int ([], False) = 0\<close>
