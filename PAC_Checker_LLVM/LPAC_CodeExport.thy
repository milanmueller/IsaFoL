lemma signed_big_int0_refine: \<open>(signed_big_int0, int0) \<in> signed_big_int_rel\<close>
  by (auto simp: signed_big_int0_def int0_def signed_big_int_rel_def in_br_conv
      signed_big_int0_\<alpha> signed_big_int_invar_def big_int_invar_def \<sigma>_def limbs_of_def)

