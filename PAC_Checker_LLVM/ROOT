chapter PAC_Checker_LLVM

session PAC_Checker_LLVM = "Isabelle_LLVM" +
  description \<open>LPAC proof checker with refinement to verified LLVM code\<close>
  options
    [timeout = 5400, quick_and_dirty]
  sessions
    "HOL-Library"
    "HOL-Algebra"
    "Polynomials"
    Nested_Multisets_Ordinals
    BigInt_LLVM
    Show
  theories
    (* Abstract specification *)
    PAC_More_Poly
    PAC_Misc
    PAC_Specification
    LPAC_Specification
    Finite_Map_Multiset
    PAC_Checker_Specification
    LPAC_Checker_Specification
    (* Refinement infrastructure *)
    Aux_Lemmas
    LLVM_Assn_Env
    More_Loops
    More_EOArray
    PAC_Map_Rel
    PAC_Checker_Relation
    (* Data structures *)
    LLVM_DS_Copying_List
    LLVM_DS_Partial_Map
    LLVM_DS_Hash_Set
    LLVM_DS_Hash_Map
    LLVM_DS_Char
    LLVM_DS_String
    LLVM_ASCII_String
    LLVM_List_Sorting
    PAC_Polynomials_Assn
    LLVM_DS_Char_Literals
    (* Polynomial layer *)
    PAC_Polynomials
    PAC_Polynomials_Term
    PAC_Polynomials_Operations
    (* Checker layer *)
    PAC_Checker
    PAC_Step_Assn
    LPAC_Step_Assn
    LPAC_Checker
    LPAC_Checker_Error
    LPAC_Perfectly_Shared
    LPAC_Perfectly_Shared_Vars
    LPAC_Efficient_Checker
    LPAC_Efficient_Checker_Sorting
    LPAC_Version
    (* Synthesis *)
    PAC_Checker_Error
    PAC_Checker_Init
    PAC_Checker_Synthesis
    LPAC_Checker_Init
    LPAC_Efficient_Checker_Refinement
    LPAC_Efficient_Checker_Synthesis
    (*LPAC_Efficient_Checker_Correctness*)
    LPAC_Checker_Synthesis
    LPAC_Codegen
